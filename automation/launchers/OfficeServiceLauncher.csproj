<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>OfficeServiceLauncher</AssemblyName>
    <RootNamespace>AllinoneAgent.Automation.Launchers</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit include: this folder also holds PaperclipServiceLauncher.cs, which has its own
         Main entry point and its own .csproj. Default SDK globbing would pull both .cs files into
         whichever project builds first and fail with "Program has more than one entry point". -->
    <Compile Include="OfficeServiceLauncher.cs" />
  </ItemGroup>

</Project>

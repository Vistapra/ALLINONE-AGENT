<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PaperclipServiceLauncher</AssemblyName>
    <RootNamespace>AllinoneAgent.Automation.Launchers</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit include: see OfficeServiceLauncher.csproj in this same folder for why default
         globbing is disabled here. -->
    <Compile Include="PaperclipServiceLauncher.cs" />
  </ItemGroup>

</Project>

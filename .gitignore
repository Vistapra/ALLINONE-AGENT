# ALLINONE-AGENT .gitignore
#
# This is a SECOND LAYER of protection, not the only one. Every file actually committed to
# this repository has already been through a multi-pass manual + automated secret/privacy
# audit (see PHASE-41-secret-audit.md, PRIVACY-LEAK-REMEDIATION.md,
# BUSINESS-PROJECT-LEAK-REMEDIATION.md, FINAL-SECURITY-SWEEP.md in the project's staging
# history). Do not assume "it's gitignored" means "it's safe" — audit before adding anything
# new, especially under config/ or anything touching apps/office-bridge/auth*.

# ---------------------------------------------------------------------------
# Local credentials and secrets — never commit real values, only *.example.* templates
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
auth.json
office-bridge-auth.json
master.key
config/secrets/
*.local.json
!*.example.local.json
*.local.yaml
!*.example.local.yaml
*.local.env
!*.example.local.env
platform.local.env
config/*.local.*
!config/*.example.*

# ---------------------------------------------------------------------------
# Runtime / generated state — regenerated fresh on every install, never distributed
# ---------------------------------------------------------------------------
state.db
findings.db
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.lock
*.pid
/data/
/runtime/
/workspaces/
!tests/fixtures/synthetic-workspaces/
office-data/chat-history/
office-data/event-history/
office-data/studio-state/
office-data/launcher-state.json
office-data/office-bridge.pid
/logs/
*.log

# ---------------------------------------------------------------------------
# Node.js — generated dependency trees and build output (confirmed generated by Phase 49:
# apps/hermes3d took 637 packages / 16 min to install from clean; apps/office-bridge is 1
# package. Never commit either, even though they are currently present in this working tree.)
# ---------------------------------------------------------------------------
node_modules/
apps/hermes3d/.next/
apps/hermes3d/out/
apps/hermes3d/.turbo/
apps/*/dist/
npm-debug.log*
.npm/

# ---------------------------------------------------------------------------
# Python — bytecode cache and virtual environments
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ---------------------------------------------------------------------------
# .NET / C# — build output for the 3 launcher projects
# (automation/launchers/OfficeServiceLauncher, PaperclipServiceLauncher;
#  automation/updater/CuaDriverProxy — all confirmed buildable in Phase 49)
# ---------------------------------------------------------------------------
automation/**/bin/
automation/**/obj/
*.user

# ---------------------------------------------------------------------------
# Test / build artifacts
# ---------------------------------------------------------------------------
playwright-report/
test-results/
coverage/
.vitest-cache/

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Patch files are intentionally NOT covered by any text-normalization rule here —
# see .gitattributes. Do not add *.patch to this file; they must be tracked byte-exact.
# ---------------------------------------------------------------------------
